    {
      "cell_type": "code",
      "source": [
        "from scipy.sparse import hstack, csr_matrix\n",
        "import pandas as pd\n",
        "\n",
        "# Liste de nouveaux titres\n",
        "titres = [\n",
        "    \"ذكر الوزير إن القرار نهائي\",\n",
        "    \"أزمة النفط تتفاقم\",\n",
        "    \"أعلن الرئيس عن مبادرة جديدة\"\n",
        "]\n",
        "\n",
        "# Transformer en TF-IDF\n",
        "X_new_tfidf = vectorizer.transform(titres)\n",
        "\n",
        "# Ajouter les features linguistiques comme lors de l'entraînement\n",
        "declarative_verbs = [\"قال\",\"أعلن\",\"صرح\",\"أكد\",\"أوضح\",\"أشار\",\"كشف\",\"ذكر\",\"بيّن\",\"شدد\",\"نفى\",\"تحدث\",\"دعا\",\"أفاد\",\"رد\",\"علق\"]\n",
        "contains_verbs = [int(any(v in t for v in declarative_verbs)) for t in titres]\n",
        "starts_with_verbs = [int(any(t.strip().startswith(v) for v in declarative_verbs)) for t in titres]\n",
        "\n",
        "# Combiner TF-IDF + features linguistiques\n",
        "X_new = hstack([X_new_tfidf, csr_matrix(list(zip(contains_verbs, starts_with_verbs)))])\n",
        "\n",
        "# Prédire\n",
